# Copy to .env.local and fill in. Never commit .env.local.
# Project URL and publishable (anon) key: Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side secrets. These are NOT read by the browser (no VITE_ prefix). Keep them
# here in .env.local, then push them to the Edge Functions with `supabase secrets set`
# (see CLAUDE.md). Never paste them into chat or commit them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
# Paystack: use a TEST key (sk_test_...) until the school is verified for live payments.
PAYSTACK_SECRET_KEY=
# Where the app is served from (comma-separated for several); localhost is always allowed.
APP_URL=
